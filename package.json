{
  "name": "handrail",
  "version": "0.1.0",
  "description": "A desktop overlay that sees your screen and walks you through complex software, step by step.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --no-sandbox",
    "test": "node --test \"spike/**/*.test.js\" \"src/**/*.test.js\"",
    "spike:arrow": "electron spike/arrow",
    "dev:renderer": "electron renderer/dev.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "pack": "electron-builder --dir",
    "clean": "rimraf dist"
  },
  "author": {
    "name": "m19k1"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "rimraf": "^5.0.5"
  },
  "build": {
    "appId": "com.handrail.app",
    "productName": "Handrail",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-arrow.js",
      "renderer/**/*",
      "design/tokens.css",
      "design/brand/*.svg",
      "src/**/*",
      "!renderer/dev.js",
      "!renderer/mock-bridge.js",
      "!spike/**/*",
      "!**/*.test.js"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Handrail takes a screenshot when you ask it a question, so it can answer about what is on your screen.",
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "artifactName": "Handrail-Setup-${version}.${ext}"
    },
    "dmg": {
      "title": "Handrail",
      "backgroundColor": "#131519"
    }
  }
}
