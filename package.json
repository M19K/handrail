{
  "name": "handrail",
  "version": "0.1.4",
  "description": "A desktop overlay that sees your screen and walks you through complex software, step by step.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --no-sandbox",
    "test": "node --test \"spike/**/*.test.js\" \"src/**/*.test.js\"",
    "spike:arrow": "electron spike/arrow",
    "dev:renderer": "electron renderer/dev.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac && npm run verify:mac",
    "verify:mac": "node scripts/verify-mac-build.js",
    "tray-icons": "node scripts/make-tray-icons.js",
    "build:win": "electron-builder --win",
    "pack": "electron-builder --dir",
    "clean": "rimraf dist",
    "qa": "node --test --test-concurrency=1 tests/qa/*.test.js",
    "compare-models": "electron scripts/compare-models.js"
  },
  "author": {
    "name": "Maaz Kazi",
    "url": "https://github.com/M19K"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1",
    "rimraf": "^5.0.5"
  },
  "build": {
    "appId": "com.handrail.app",
    "productName": "Handrail",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "scripts/afterpack-mac.js",
    "files": [
      "main.js",
      "preload.js",
      "preload-arrow.js",
      "renderer/**/*",
      "design/tokens.css",
      "design/brand/*.svg",
      "src/**/*",
      "assets/**/*",
      "!renderer/dev.js",
      "!renderer/mock-bridge.js",
      "!spike/**/*",
      "!**/*.test.js",
      "LICENSE",
      "NOTICE"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Handrail takes a screenshot when you ask it a question, so it can answer about what is on your screen.",
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "artifactName": "Handrail-Setup-${version}.${ext}"
    },
    "dmg": {
      "title": "Handrail",
      "backgroundColor": "#131519"
    }
  },
  "homepage": "https://github.com/M19K/handrail",
  "repository": {
    "type": "git",
    "url": "https://github.com/M19K/handrail.git"
  },
  "bugs": {
    "url": "https://github.com/M19K/handrail/issues"
  },
  "keywords": [
    "electron",
    "ai-assistant",
    "screen-capture",
    "desktop-overlay",
    "openrouter",
    "accessibility"
  ]
}
